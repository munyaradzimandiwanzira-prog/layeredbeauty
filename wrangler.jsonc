{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "layered-beauty",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Worker handles /api/* and the apex → www redirect; everything else is static.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "layered-beauty",
      "database_id": "3e2a83b1-5e5a-4c11-9f0f-48a156205b7e",
      "migrations_dir": "migrations"
    }
  ],
  // ADMIN_TOKEN is a secret: `npx wrangler secret put ADMIN_TOKEN`
  "workers_dev": true,
  "routes": [
    { "pattern": "www.layeredbeautystudio.com", "custom_domain": true },
    { "pattern": "layeredbeautystudio.com", "custom_domain": true }
  ]
}
